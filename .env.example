# Copy to .env.local; leave secrets out of Git. All blank values need setup.
# The portfolio renders without these; backend requests fail safely.
SUPABASE_URL=
# Public/publishable key (or legacy anon key), never a secret/service-role key.
SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (or legacy service-role key).
SUPABASE_SERVICE_ROLE_KEY=
# Exact origin without trailing slash; localhost:3001 for the documented preview.
SITE_ORIGIN=http://localhost:3001
TURNSTILE_HOSTNAME=localhost
TURNSTILE_SECRET_KEY=
TURNSTILE_MODE=real
# Public Turnstile widget site key; submissions stay disabled when missing.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Random secret with at least 32 characters; never reuse another credential.
RATE_LIMIT_HMAC_SECRET=
# Only set after verifying that your hosting edge overwrites this header.
# Allowed: x-nf-client-connection-ip OR cf-connecting-ip. Never x-forwarded-for.
TRUSTED_IP_HEADER=
# Explicit LOCAL development only: all requests share a loopback quota.
# This fallback is disabled in production regardless of the value below.
BACKEND_LOCAL_IP=false
